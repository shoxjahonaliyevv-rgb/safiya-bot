function normalizePostChannel($value){
 $value = trim($value);
 $value = preg_replace('~^https?://t\.me/~i','',$value);
 $value = preg_replace('~^t\.me/~i','',$value);
 $value = trim($value,'/');
 $value = ltrim($value,'@');
 if(!preg_match('/^[A-Za-z0-9_]{5,32}$/',$value)) return '';
 return $value;
}

function parsePostLink($value){
 $value = trim(preg_replace('/[\r\n\s]+/u','',$value));
 if(!preg_match('~^https?://t\.me/(?:s/)?([A-Za-z0-9_]+)/(\d+)(?:\?.*)?$~i',$value,$match)){
  return null;
 }
 $channel = normalizePostChannel($match[1]);
 $post_id = (int)$match[2];
 if(empty($channel) || $post_id < 1) return null;
 return [
  'channel'=>$channel,
  'id'=>$post_id,
  'url'=>"https://t.me/".$channel."/".$post_id
 ];
}

