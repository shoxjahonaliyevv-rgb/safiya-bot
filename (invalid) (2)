function workerAlreadyCompleted($file,$worker_id){
 $worker_id = (string)$worker_id;
 if(!file_exists($file)) return false;
 $lines = @file($file,FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
 if($lines===false) return false;
 foreach($lines as $line){
  if(trim((string)$line)===$worker_id) return true;
 }
 return false;
}

function addWorkerOnce($file,$worker_id){
 $worker_id = (string)$worker_id;
 $handle = @fopen($file,'c+');
 if($handle===false) return false;
 $added = false;
 if(flock($handle,LOCK_EX)){
  rewind($handle);
  $contents = stream_get_contents($handle);
  $lines = preg_split('/\R/',(string)$contents,-1,PREG_SPLIT_NO_EMPTY);
  foreach($lines as $line){
   if(trim((string)$line)===$worker_id){
    flock($handle,LOCK_UN);
    fclose($handle);
    return false;
   }
  }
  fseek($handle,0,SEEK_END);
  fwrite($handle,$worker_id."\n");
  fflush($handle);
  flock($handle,LOCK_UN);
  $added = true;
 }
 fclose($handle);
 return $added;
}

function countWorkers($file){
 if(!file_exists($file)) return 0;
 $lines = @file($file,FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
 if($lines===false) return 0;
 $unique = [];
 foreach($lines as $line){
  $line = trim((string)$line);
  if($line!=='') $unique[$line] = true;
 }
 return count($unique);
}

function shu_yerda_topilgan_buyurtma($cid2,$only_tur=null){
$turlar = $only_tur===null ? ['kn','gr','pv'] : [$only_tur];
foreach($turlar as $tur){
$dir = "aktiv_buyurtma/$tur";
if(!is_dir($dir)) continue;
 $fayllar = @scandir($dir);
if(!$fayllar) continue;
foreach($fayllar as $f){
 if($f==='.' || $f==='..' || substr($f,-4)!==".txt") continue;
$mid = str_replace(".txt","",$f);
$mazmun = trim(@file_get_contents("$dir/$f"));
if($mazmun=="") continue;
$qism = explode("|",$mazmun);
if(count($qism)<3) continue;
list($pulmiq,$egasi,$user) = $qism;
 if((int)$pulmiq<1 || trim((string)$egasi)==='' || trim((string)$user)==='') continue;
if($egasi==$cid2) continue; // o'z buyurtmasiga obuna bo'lolmaydi
  $worker_file = "nakrutka/user/$mid.txt";
  if(workerAlreadyCompleted($worker_file,$cid2)) continue; // avval oldi
  $bajarildi = countWorkers($worker_file);
  if($bajarildi >= (int)$pulmiq) continue; // tugagan, lekin fayl o'chirilmagan bo'lsa ham chiqmasin
return ['tur'=>$tur,'mid'=>$mid,'pulmiq'=>(int)$pulmiq,'egasi'=>$egasi,'user'=>$user];
}
}
return null;
}

